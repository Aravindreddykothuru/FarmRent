# FarmRent web app (Next.js) — optional overrides.
#
# The unified server (server.js) loads the backend env file (Backend_Node_legacy/.env, or the file
# named by FARMRENT_ENV_FILE) before Next.js starts, so one file can hold everything. Put values in
# nextfrontend/.env.local only when the web build needs something different. Never commit .env.local.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time — never put a secret in one,
# and remember that `npm run build` picks up .env.local from this machine.

# ─── API location ─────────────────────────────────────────────────────────────
# Leave empty for the unified server: the browser then calls /api/v1 on its own origin.
# Set only when the API is served from a different origin.
NEXT_PUBLIC_API_URL=
# How server-side rendering and rewrites reach the API (default http://localhost:3000).
INTERNAL_API_URL=
# Alternative API origin read by some tracking/geolocation code; falls back to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_BACKEND_URL=
# Public URL shown in share links and the GPS device setup guide.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Serve /_next assets from a CDN (optional).
CDN_URL=

# ─── Maps ─────────────────────────────────────────────────────────────────────
# Google Maps JavaScript API browser key — restrict it to your domains in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Error tracking (optional) ────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build time only: uploads source maps when set.
SENTRY_AUTH_TOKEN=
