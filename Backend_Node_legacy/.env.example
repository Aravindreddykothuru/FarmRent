# FarmRent API configuration — read by the unified server (nextfrontend/server.js) and the backend scripts.
#
# Local development: don't fill this in by hand. From the repo root, `node scripts/setup-local-env.js`
# writes Backend_Node_legacy/.env for the local Docker stack with freshly generated secrets.
# The server loads Backend_Node_legacy/.env, or the file named by FARMRENT_ENV_FILE.
# Never commit a filled-in copy.
#
# Needed for the app to work: JWT_SECRET, JWT_REFRESH_SECRET, SUPABASE_URL, SUPABASE_SERVICE_KEY, REDIS_URL.
# Optional integrations either fall back (local file storage, logged dev OTPs, captured dev emails) or
# answer 503 until configured (online payments, Google sign-in).
# Older names still accepted: SUPABASE_SERVICE_ROLE_KEY, JWT_ACCESS_SECRET, EMAIL_USER / EMAIL_PASS.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public URL of the app, used in email links.
APP_URL=http://localhost:3000
# Browser origins allowed to call the API (comma-separated). In production list only your real domains.
ALLOWED_ORIGINS=http://localhost:3000
# Origin allowed to open Socket.IO connections; also where Google sign-in returns users.
CLIENT_URL=http://localhost:3000
# Reverse-proxy hops to trust for the client IP that rate limits use (e.g. 1 behind a load balancer).
TRUST_PROXY=
# When set, GET /metrics requires "Authorization: Bearer <METRICS_TOKEN>".
METRICS_TOKEN=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Two different long random values: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# Google sign-in (optional; the endpoints answer 503 until both are set).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase project URL (locally the PostgREST gateway, http://localhost:54321) and its service_role key.
# The service_role key is a server secret — never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Direct Postgres connection used by `npm run migrate`, `npm run seed` and the integration tests.
DATABASE_URL=
# Password for the demo accounts `npm run seed` creates (development only; default FarmRent@2026).
SEED_PASSWORD=

# ─── Redis ────────────────────────────────────────────────────────────────────
# Refresh tokens and sessions, rate limits, caches and background queues.
REDIS_URL=redis://127.0.0.1:6380
# Default cache lifetime in seconds.
REDIS_DEFAULT_TTL=300

# ─── Payments: Razorpay (optional) ────────────────────────────────────────────
# Without keys, online payment requests answer 503 and renters pay cash on delivery.
# Use rzp_test_* keys in development and rzp_live_* in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret (Razorpay Dashboard → Webhooks); the webhook endpoint answers 503 until it is set.
RAZORPAY_WEBHOOK_SECRET=

# ─── Email (optional) ─────────────────────────────────────────────────────────
# Providers are tried in order Brevo → SMTP → Resend → Ethereal test inbox; EMAIL_PROVIDER=smtp or resend
# moves that provider to the front. In development every sent email can also be read at /dev/emails.
EMAIL_PROVIDER=
EMAIL_FROM="FarmRent <no-reply@example.com>"
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_SENDER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
RESEND_FROM=

# ─── OTP delivery (optional) ──────────────────────────────────────────────────
# Tried in order: email, Twilio WhatsApp, Meta WhatsApp, MSG91 SMS, Twilio SMS. Outside production the
# server logs the code when no provider is configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# ─── File storage (optional) ──────────────────────────────────────────────────
# S3 or an S3-compatible service for listing photos and avatars; local storage is used without credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=

# ─── Search and monitoring (optional) ─────────────────────────────────────────
# Elasticsearch for listing search; PostgreSQL search is used when unset.
ELASTICSEARCH_NODE=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
SENTRY_DSN=

# ─── Test tooling ─────────────────────────────────────────────────────────────
# Integration tests refuse to run against a non-local SUPABASE_URL unless this is "true".
ALLOW_NON_LOCAL_TEST_DB=
# Defaults for scripts/e2e-acceptance.js.
E2E_BASE_URL=http://localhost:3000
E2E_ADMIN_EMAIL=admin@farmrent.local
