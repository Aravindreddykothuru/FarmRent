# Node.js Backend Environment Variables
# Copy this to .env and fill in real values

NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/farmrent

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE=7d

# Redis (optional — app runs in degraded mode without it)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=farm:
REDIS_DEFAULT_TTL=300
REDIS_SEARCH_TTL=120

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Flask Micro-service URL
FLASK_URL=http://localhost:5001
FLASK_PORT=5001

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Field Encryption (AES-256-GCM) — 64 hex chars = 32 bytes
FIELD_ENCRYPTION_KEY=

# Cluster
CLUSTER_MODE=false
WORKER_COUNT=

# Logging
LOG_LEVEL=info

# =========================================================================
# 📧 Nodemailer SMTP Configuration (Forgot Password Email)
# =========================================================================
# Host name of your SMTP server (e.g., smtp.gmail.com, smtp.mailtrap.io)
EMAIL_HOST=
# Port number of your SMTP server (typically 587 for TLS, or 465 for SSL)
EMAIL_PORT=587
# SMTP username (e.g., your email address or Mailtrap username)
EMAIL_USER=
# SMTP password (e.g., your email password or app-specific password)
EMAIL_PASS=

# =========================================================================
# 📱 Twilio SMS Configuration (Forgot Password SMS)
# =========================================================================
# Your Twilio Account SID (found in console)
TWILIO_ACCOUNT_SID=
# Your Twilio Auth Token (found in console)
TWILIO_AUTH_TOKEN=
# Your Twilio Phone Number (must be active in Twilio account)
TWILIO_PHONE_NUMBER=

