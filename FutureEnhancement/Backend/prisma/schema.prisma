generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(uuid())
  fullName      String            @map("full_name")
  email         String            @unique
  phone         String?
  password_hash String
  role          Role              @default(FARMER)
  createdAt     DateTime          @default(now()) @map("created_at")

  equipment     Equipment[]
  rentals       EquipmentRental[]
  reviews       Review[]

  @@map("users")
}

enum Role {
  FARMER
  OWNER
  ADMIN
}

model Equipment {
  id            String            @id @default(uuid())
  ownerId       String            @map("owner_id")
  name          String
  category      String
  description   String            @db.Text
  pricePerHour  Decimal?          @db.Decimal(10, 2) @map("price_per_hour")
  dailyRate     Decimal           @db.Decimal(10, 2) @map("daily_rate")
  latitude      Float
  longitude     Float
  address       String            @db.Text
  status        EquipmentStatus   @default(AVAILABLE)
  isVerified    Boolean           @default(false) @map("is_verified")
  depositAmount Decimal?          @db.Decimal(10, 2) @map("deposit_amount")
  yearOfMfg     Int?              @map("year_of_mfg")
  condition     String?
  createdAt     DateTime          @default(now()) @map("created_at")

  owner         User              @relation(fields: [ownerId], references: [id])
  rentals       EquipmentRental[]

  @@map("equipment")
}

enum EquipmentStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  UNAVAILABLE
}

model EquipmentRental {
  id            String        @id @default(uuid())
  renterId      String        @map("renter_id")
  ownerId       String        @map("owner_id")
  equipmentId   String        @map("equipment_id")
  startTime     DateTime      @map("start_time")
  endTime       DateTime      @map("end_time")
  dailyRate     Decimal       @db.Decimal(10, 2) @map("daily_rate")
  status        String        @default("requested")
  totalAmount   Decimal       @db.Decimal(10, 2) @map("total_amount")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  pickupLocation String?      @db.Text @map("pickup_location")
  returnLocation String?      @db.Text @map("return_location")
  ownerNotes    String?       @db.Text @map("owner_notes")
  createdAt     DateTime      @default(now()) @map("created_at")

  renter        User          @relation(fields: [renterId], references: [id])
  equipment     Equipment     @relation(fields: [equipmentId], references: [id])
  payment       Payment?
  review        Review?

  @@map("equipment_rentals")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id             String          @id @default(uuid())
  referenceId    String          @unique @map("reference_id")
  paymentGateway PaymentGateway  @map("payment_gateway")
  amount         Decimal         @db.Decimal(10, 2)
  paymentStatus  PaymentStatus   @default(PENDING) @map("payment_status")
  transactionId  String?         @unique @map("transaction_id")
  createdAt      DateTime        @default(now()) @map("created_at")

  rental         EquipmentRental @relation(fields: [referenceId], references: [id])

  @@map("payments")
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
}

model Review {
  id          String          @id @default(uuid())
  rentalId    String          @unique @map("rental_id")
  reviewerId  String          @map("reviewer_id")
  rating      Int             @db.SmallInt
  reviewText  String?         @db.Text @map("review_text")
  createdAt   DateTime        @default(now()) @map("created_at")

  rental      EquipmentRental @relation(fields: [rentalId], references: [id])
  reviewer    User            @relation(fields: [reviewerId], references: [id])

  @@map("reviews")
}
