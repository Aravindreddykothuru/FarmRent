# FarmRent backend — copy to .env and fill in secrets
# Unified UI+API: npm run dev in nextfrontend/ (reads Backend/.env)
# API only:       cd Backend && npm start → http://localhost:5000

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Access token secret — 15-minute expiry
# Generate: openssl rand -base64 48
JWT_SECRET=replace-with-openssl-rand-base64-48

# Refresh token secret — 7-day expiry (must differ from JWT_SECRET in production)
JWT_REFRESH_SECRET=replace-with-a-different-openssl-rand-base64-48

# ─── App URL ──────────────────────────────────────────────────────────────────
# Used to build email verification and password-reset links
APP_URL=http://localhost:3000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowed browser origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
CLIENT_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys
# Use rzp_test_* for dev, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Dashboard → Settings → Webhooks → Secret (required for production)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
# Used for email verification, password reset, and booking receipts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="FarmRent <your@gmail.com>"

# ─── SMS / OTP ────────────────────────────────────────────────────────────────
# Falls back to console.log when not configured (safe for local dev)

# MSG91 (recommended for India)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_otp_template_id
# DLT-registered 6-char sender ID for transactional SMS (default: FRMRNT)
MSG91_SENDER_ID=FRMRNT

# Twilio (fallback)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1234567890

# ─── Flask ML service (optional) ─────────────────────────────────────────────
# Proxied at /api/v2 → Flask /api
FLASK_URL=http://localhost:5001

# ─── Sentry error tracking (optional) ────────────────────────────────────────
# Only active when DSN is set; zero overhead when blank
SENTRY_DSN=
