# Local Docker stack settings — docker compose reads these from .env in this directory.
#
# Don't copy this file by hand: `node scripts/setup-local-env.js` writes .env (and
# Backend_Node_legacy/.env for the app) with freshly generated random secrets.
# Never commit .env.

# Postgres superuser password; PostgREST's `authenticator` role uses it too.
POSTGRES_PASSWORD=

# HS256 secret PostgREST uses to verify API keys (Supabase calls this the JWT secret).
SUPABASE_JWT_SECRET=

# service_role API key signed with SUPABASE_JWT_SECRET — the app's database credential.
SUPABASE_SERVICE_KEY=

# Token secrets for the containerised app (docker compose --profile app). Use different values.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Host ports. The defaults avoid clashing with a Postgres/Redis already running on 5432/6379.
DB_PORT=55432
SUPABASE_GATEWAY_PORT=54321
REDIS_PORT=6380
APP_PORT=3000
