{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FarmRent — unified server (local Docker stack)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/nextfrontend/server.js",
            "cwd": "${workspaceFolder}/nextfrontend",
            "env": {
                "FARMRENT_ENV_FILE": "../Backend_Node_legacy/.env"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "FarmRent — Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/nextfrontend"
        }
    ]
}
